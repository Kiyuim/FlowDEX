# Per-service image for the Railway `websocket` service. The websocket/ dir is a
# self-contained Go module (its own go.mod), so build it in isolation. Serves the
# token/kline WebSocket endpoints on :8086, subscribing to Redis pub/sub.
FROM --platform=$BUILDPLATFORM golang:1.25 AS build
ARG TARGETARCH
ENV GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOOS=linux GOARCH=$TARGETARCH
WORKDIR /src
COPY websocket/go.mod websocket/go.sum ./
RUN go mod download
COPY websocket/ ./
RUN go build -ldflags="-s -w" -o /out/app .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/app /app/app
COPY --from=build /src/etc /app/etc
EXPOSE 8086
CMD ["/app/app", "-f", "etc/websocket.yaml"]
