# Per-service image for Railway `consumer`. Matches the proven prod image
# (golang:1.25 builder + debian:bookworm-slim runtime) to avoid any
# runtime-environment differences. Builds only the consumer binary and runs it
# with its own etc/consumer.yaml (Solana devnet endpoints).
FROM golang:1.25 AS build
ENV GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOOS=linux
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/app ./consumer/consumer.go

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gettext-base && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/app /app/app
COPY --from=build /src/consumer/etc /app/etc
CMD ["/app/app", "-f", "etc/consumer.yaml"]
