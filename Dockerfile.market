# Per-service image for Railway `market`. Matches the prod image
# (golang:1.25 builder + debian:bookworm-slim runtime). market/ has multiple
# `package main` files, so build the specific entrypoint file.
FROM golang:1.25 AS build
ENV GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOOS=linux
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -ldflags="-s -w" -o /out/app ./market/market.go

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gettext-base && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/app /app/app
COPY --from=build /src/market/etc /app/etc
CMD ["/app/app", "-f", "etc/market.yaml"]
