# Copy to deploy/.env and edit. Both docker-compose AND render.sh read this file,
# so every endpoint/credential has exactly one source of truth.

# ---- public address -------------------------------------------------------
# The host or IP browsers will use. Used to bake the WebSocket URLs into the
# frontend bundle (CRA inlines REACT_APP_* at build time).
PUBLIC_HOST=47.242.157.80

# Host ports. HTTP_PORT serves the UI *and* proxies /v1, /direct-api and /ws,
# so it is the only port that strictly has to be open in the firewall.
HTTP_PORT=80
HTTPS_PORT=443
GATEWAY_PORT=8083
WEBSOCKET_PORT=8086

# ---- TLS (tls.sh) ----------------------------------------------------------
# Let's Encrypt name for the certificate. A bare IP works (6-day "shortlived"
# certs, renewed daily by cron); for a domain pointed at this host use the
# domain instead and TLS_PROFILE= (default 90-day certs).
TLS_HOST=47.242.157.80
TLS_PROFILE=shortlived
# Let's Encrypt account email (required by lego).
ACME_EMAIL=

# ---- datastores -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=fundex_selfhost_2026
MYSQL_DATABASE=fun_dexs

# ---- Solana ---------------------------------------------------------------
# Helius devnet is the default provider. Put your key here; SOL_NODE_URL /
# SOL_WS_URL and the frontend's REACT_APP_HELIUS_API_KEY are derived from it.
# Override SOL_NODE_URL / SOL_WS_URL only to use a different provider.
HELIUS_API_KEY=
SOL_NODE_URL=https://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOL_WS_URL=wss://devnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}

# Skip the full-chain block scanner (getBlock for every devnet slot), which
# exhausts a Helius free-tier quota in minutes. The program watcher still
# indexes our own launch programs. Set false on a paid plan sized for it.
CONSUMER_DISABLE_SLOT_SCANNER=true

# Parallel block-fetch workers in the consumer. 6 keeps up with devnet's
# ~2.5 blocks/s; drop to 2 if the public RPC starts 429-ing.
CONSUMER_CONCURRENCY=6
# Caps the shared getBlock rate limiter (blocks/sec). Empty = unlimited.
SOL_BLOCK_RATE_PER_SEC=

# ---- frontend (derived; normally leave as-is) ------------------------------
# wss:// works from both the self-hosted page and an https page elsewhere
# (e.g. Vercel) once tls.sh has issued the certificate.
REACT_APP_WS_URL=wss://47.242.157.80
REACT_APP_KLINE_WS_URL=wss://47.242.157.80
# Browser wallet RPC. Leave REACT_APP_SOLANA_RPC_URL empty so the frontend
# uses Helius from the key below; set it only to force another endpoint.
REACT_APP_SOLANA_RPC_URL=
REACT_APP_HELIUS_API_KEY=${HELIUS_API_KEY}
# Optional second provider the browser retries against on a 429.
REACT_APP_SOLANA_RPC_FALLBACK_URL=
