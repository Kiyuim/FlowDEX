# Frontend image: build the CRA/craco app, serve it with nginx, and reverse-proxy
# the API (/v1, /direct-api) and WebSocket (/ws) so the whole app is one origin.
#
# Build context is the REPO ROOT (see docker-compose.yml).
FROM --platform=$BUILDPLATFORM node:18-bullseye AS build
WORKDIR /src

COPY pump-tokens-ui/package.json pump-tokens-ui/package-lock.json* ./
# --legacy-peer-deps: the Solana wallet-adapter tree has peer ranges npm 8+
# refuses to resolve strictly.
RUN npm install --legacy-peer-deps --no-audit --no-fund

COPY pump-tokens-ui/ ./

# CRA bakes REACT_APP_* into the bundle at build time.
ARG REACT_APP_WS_URL
ARG REACT_APP_KLINE_WS_URL
ARG REACT_APP_SOLANA_RPC_URL
ARG REACT_APP_HELIUS_API_KEY
ARG REACT_APP_SOLANA_RPC_FALLBACK_URL
ENV REACT_APP_WS_URL=$REACT_APP_WS_URL \
    REACT_APP_KLINE_WS_URL=$REACT_APP_KLINE_WS_URL \
    REACT_APP_SOLANA_RPC_URL=$REACT_APP_SOLANA_RPC_URL \
    REACT_APP_HELIUS_API_KEY=$REACT_APP_HELIUS_API_KEY \
    REACT_APP_SOLANA_RPC_FALLBACK_URL=$REACT_APP_SOLANA_RPC_FALLBACK_URL \
    NODE_OPTIONS=--max-old-space-size=4096 \
    CI=false
# CI=false is required: react-scripts treats ESLint warnings as errors when CI=true.
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/build /usr/share/nginx/html
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
